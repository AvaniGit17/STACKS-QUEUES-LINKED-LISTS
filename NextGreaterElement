#include <iostream>
#include <stack>
#include <vector>
using namespace std;
vector<int>nextgreaterElement(vector<int> &arr){
    int n = arr.size();
    vector<int>res(n, -1);
    for( int i = 0; i<n ; i++){
        for( int j= i+1; j<n; j++){
            if( arr[j]>arr[i]){
                res[i]= arr[j];
                break;
            }
        }
    }
    return res;
}

int main() {
    vector<int>arr= { 1,3,2,4};
    vector<int>res= nextgreaterElement(arr);
    for(int x : res){
        cout<<x<<" ";
    }
    return 0;
}
