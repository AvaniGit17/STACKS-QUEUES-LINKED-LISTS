#include <iostream>
#include <vector>
#include <algorithm>

#include <stack>
using namespace std;
int main(){
    vector<int> ht = {2, 1, 4, 3};
    int n =  ht.size();
    
    stack<int> s;

 vector<int>right(n);
    for( int i = n-1; i>=0 ; i--){
    while( s.size()>0 &&   ht[s.top()]>= ht[i]){
            s.pop();
    }
right[i] = s.empty() ? -1 : s.top();
 
    s.push(i);
    }

cout<<"right smaller nearest :";
for(int i = 0; i<n; i++){
    cout<< right[i]<<" ";
}
return 0;
}

    
